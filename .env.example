# Backend environment variables

# Port for the Express server (default: 5000)
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/releasepilot

# Gemini API Key for LangChain AI features
# Required for AI analysis and brief generation
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model to use (default: gemini-2.5-flash)
LLM_MODEL=gemini-2.5-flash
